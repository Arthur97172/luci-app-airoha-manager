# --- WAN / bridge-offload guard ---------------------------------------------
#
# From luci.airoha_npu. The bridge offload toggles (VLAN tag, PPPoE
# passthrough, AP mode) all rewrite net.bridge.bridge-nf-* sysctls, which
# change how the kernel treats bridged traffic. Turning any of them on while a
# WAN is actually up breaks hardware flow offload for the router case, so the
# setters refuse it and the NPU page greys the toggles out.
_has_active_wan() {
	local wan_status up l3_device ipv4 ipv6

	wan_status=$(ubus call network.interface.wan status 2>/dev/null)
	[ -n "$wan_status" ] || return 1

	up=$(printf '%s' "$wan_status" | jsonfilter -e "@.up" 2>/dev/null)
	[ "$up" = "true" ] || return 1

	l3_device=$(printf '%s' "$wan_status" | jsonfilter -e "@.l3_device" 2>/dev/null)
	ipv4=$(printf '%s' "$wan_status" | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)
	ipv6=$(printf '%s' "$wan_status" | jsonfilter -e "@['ipv6-address'][0].address" 2>/dev/null)

	[ -n "$l3_device$ipv4$ipv6" ]
}

_bridge_offload_blocked() {
	_has_active_wan
}

_bridge_offload_block_error() {
	echo '{"error":"Bridge VLAN-tag / PPPoE-passthrough / AP-mode offload is disabled while WAN is active; use Hardware Flow Offload in router mode"}'
}

# --- Flat PPE entry table ---------------------------------------------------
#
# From luci.airoha_npu, and a different shape from get_ppe_summary above: this
# one returns one row per bound entry, which is what the NPU page's flow table
# renders. get_ppe_summary returns the bound/unbound totals and per-band
# breakdown the FlowSense overview needs. Both read the same debugfs files and
# neither replaces the other.
get_ppe_entries() {
	local entries_file="/sys/kernel/debug/ppe/entries"

	if [ ! -f "$entries_file" ]; then
		echo '{"entries":[]}'
		return
	fi

	awk '
	BEGIN {
		printf "{\"entries\":["
		first = 1
	}
	/^[0-9a-fA-F]+ / {
		if (first == 0) printf ","
		first = 0

		index_val = $1
		state = $2

		type = ""
		subtype = ""
		if ($3 == "IPv4" || $3 == "IPv6") {
			type = $3
			subtype = $4
		} else if ($3 == "L2B" || $4 == "L2B") {
			type = "L2B"
			subtype = ""
		} else {
			type = $3
			subtype = $4
		}

		orig = ""
		match($0, /orig=[^ ]+/)
		if (RSTART > 0) {
			orig = substr($0, RSTART+5, RLENGTH-5)
		}

		new_flow = ""
		match($0, /new=[^ ]+/)
		if (RSTART > 0) {
			new_flow = substr($0, RSTART+4, RLENGTH-4)
		}

		eth = ""
		match($0, /eth=[^ ]+/)
		if (RSTART > 0) {
			eth = substr($0, RSTART+4, RLENGTH-4)
		}

		printf "{\"index\":\"%s\",\"state\":\"%s\",\"type\":\"%s %s\",\"orig\":\"%s\",\"new_flow\":\"%s\",\"eth\":\"%s\"}", \
			index_val, state, type, subtype, orig, new_flow, eth
	}
	END {
		printf "]}"
	}
	' "$entries_file" 2>/dev/null || echo '{"entries":[]}'
}

# --- CPU governor / frequency control ---------------------------------------
#
# From luci.airoha_npu. Both validate their argument against the cpufreq sysfs
# lists before writing, so a stale page cannot push an unsupported value.
set_governor() {
	local governor
	governor=$(echo "$1" | jsonfilter -e "@.governor" 2>/dev/null)

	if [ -z "$governor" ]; then
		echo '{"error":"missing governor parameter"}'
		return
	fi

	# Validate governor is available
	local avail=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null)
	if ! echo "$avail" | grep -qw "$governor"; then
		printf '{"error":"invalid governor: %s"}' "$governor"
		return
	fi

	echo "$governor" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
	if [ $? -eq 0 ]; then
		printf '{"result":"ok","governor":"%s"}' "$governor"
	else
		echo '{"error":"failed to set governor"}'
	fi
}

set_max_freq() {
	local freq
	freq=$(echo "$1" | jsonfilter -e "@.freq" 2>/dev/null)

	if [ -z "$freq" ]; then
		echo '{"error":"missing freq parameter"}'
		return
	fi

	# Validate freq is in available list
	local avail=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies 2>/dev/null)
	if ! echo "$avail" | grep -qw "$freq"; then
		printf '{"error":"invalid frequency: %s"}' "$freq"
		return
	fi

	echo "$freq" > /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2>/dev/null
	if [ $? -eq 0 ]; then
		printf '{"result":"ok","freq":%d}' "$freq"
	else
		echo '{"error":"failed to set max frequency"}'
	fi
}

# --- Offload toggles --------------------------------------------------------
#
# From luci.airoha_npu. The getters for all five toggles live further up, in the
# block shared with FlowSense; only the setters are NPU-page specific. Each one
# writes the sysctl immediately and persists it under /etc/sysctl.d/ so the
# setting survives a reboot, and each refuses to enable bridge-level offload
# while a WAN is active.
set_vlan_offload() {
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi
	# The bridge-nf-* sysctls live under /proc/sys/net/bridge/, which exists only
	# once br_netfilter is loaded — `bridge` alone does not create them. kmod-
	# br-netfilter autoloads from /etc/modules.d/br-netfilter at boot, but a
	# freshly installed kmod is not loaded until then, so load it here as well.
	modprobe br_netfilter 2>/dev/null
	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null; then
		echo '{"error":"failed - bridge module may not be loaded"}'
		return
	fi
	echo "net.bridge.bridge-nf-filter-vlan-tagged=$enabled" > /etc/sysctl.d/14-vlan-offload.conf
	printf '{"result":"ok","enabled":%d}' "$enabled"
}
set_pppoe_offload() {
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi
	# br_netfilter, not bridge: the bridge-nf-* sysctls are created by
	# br_netfilter, so loading `bridge` alone leaves them missing.
	modprobe br_netfilter 2>/dev/null
	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-filter-pppoe-tagged 2>/dev/null; then
		echo '{"error":"failed - bridge module may not be loaded"}'
		return
	fi
	echo "net.bridge.bridge-nf-filter-pppoe-tagged=$enabled" > /etc/sysctl.d/13-pppoe-offload.conf
	# Also load PPTP conntrack helper for PPPoE offload support
	if [ "$enabled" = "1" ]; then
		modprobe nf_conntrack_pptp 2>/dev/null
		modprobe nf_nat_pptp 2>/dev/null
	fi
	printf '{"result":"ok","enabled":%d}' "$enabled"
}
set_flow_offload() {
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	# Set both flow_offloading and flow_offloading_hw (consistent with flowsense)
	uci set firewall.@defaults[0].flow_offloading="$enabled" 2>/dev/null
	uci set firewall.@defaults[0].flow_offloading_hw="$enabled" 2>/dev/null
	uci commit firewall 2>/dev/null
	# Restart firewall to apply changes
	/etc/init.d/firewall restart 2>/dev/null &
	printf '{"result":"ok","enabled":%d}' "$enabled"
}
set_apmode_offload() {
	local enabled vlan_filtering vlan_options

	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi

	modprobe br_netfilter 2>/dev/null
	vlan_filtering=$(_apmode_has_vlan_filtering)
	vlan_options=0
	[ "$vlan_filtering" = "1" ] && vlan_options=$enabled

	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-ip6tables 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-arptables 2>/dev/null ||
	   ! echo "$vlan_options" > /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null ||
	   ! echo "$vlan_options" > /proc/sys/net/bridge/bridge-nf-pass-vlan-input-dev 2>/dev/null; then
		echo '{"error":"failed to configure bridge netfilter"}'
		return
	fi

	if [ "$enabled" = "1" ]; then
		{
			echo 'net.bridge.bridge-nf-call-iptables=1'
			echo 'net.bridge.bridge-nf-call-ip6tables=1'
			echo 'net.bridge.bridge-nf-call-arptables=1'
			echo "net.bridge.bridge-nf-filter-vlan-tagged=$vlan_options"
			echo "net.bridge.bridge-nf-pass-vlan-input-dev=$vlan_options"
		} > /etc/sysctl.d/12-apmode-offload.conf
	else
		rm -f /etc/sysctl.d/12-apmode-offload.conf 2>/dev/null
	fi

	printf '{"result":"ok","enabled":%d,"vlan_filtering":%d}' "$enabled" "$vlan_filtering"
}

# --- Fan control ------------------------------------------------------------
#
# From luci.fan. The lookups below walk /sys/class/hwmon for the NCT7802 fan
# controller and the mt7996 per-band temperature sensors, because their hwmon
# indices follow probe order and are not stable across boots.
#
# The walk is deferred to the first fan call instead of running at script load.
# This backend also serves the NPU and FlowSense pages, and an eager scan would
# make every one of their polls pay for a walk of /sys/class/hwmon that only the
# fan page needs.

_fan_find_nct7802() {
	local hwmon
	for hwmon in /sys/class/hwmon/hwmon*; do
		if [ -f "$hwmon/name" ] && [ "$(cat "$hwmon/name" 2>/dev/null)" = "nct7802" ]; then
			echo "$hwmon"
			return
		fi
	done
	echo "/sys/class/hwmon/hwmon5"  # fallback
}

# Locate the mt7996 hwmon for one band (0, 1 or 2).
_fan_find_mt7996_hwmon() {
	local band="$1"
	local hwmon name
	for hwmon in /sys/class/hwmon/hwmon*; do
		if [ -f "$hwmon/name" ]; then
			name=$(cat "$hwmon/name" 2>/dev/null)
			case "$name" in
				mt7996_phy0."$band"|mt7996_phy0_"$band")
					echo "$hwmon"
					return
					;;
			esac
		fi
	done
	echo ""
}

# Locate a PHY hwmon (mt7530 DSA) by name suffix, e.g. ":05" or ":08".
_fan_find_phy_hwmon() {
	local suffix="$1"
	local hwmon name
	for hwmon in /sys/class/hwmon/hwmon*; do
		if [ -f "$hwmon/name" ]; then
			name=$(cat "$hwmon/name" 2>/dev/null)
			case "$name" in
				*"$suffix")
					echo "$hwmon"
					return
					;;
			esac
		fi
	done
	echo ""
}

_fan_hwmon_ready=""

# Resolve the hwmon paths once per invocation, reusing the answer an earlier
# invocation left behind.
_fan_hwmon_init() {
	[ -n "$_fan_hwmon_ready" ] && return 0
	_fan_hwmon_ready=1

	local cache="/tmp/luci-airoha-manager.fan-hwmon.conf"
	local cached_name=""
	HWMON=""
	PHY1_HWMON=""
	PHY2_HWMON=""
	WIFI_24G_HWMON=""
	WIFI_5G_HWMON=""
	WIFI_6G_HWMON=""

	if [ -f "$cache" ]; then
		# Plain key=value data, parsed rather than sourced. The original read
		# this file with ".", which runs whatever it contains as root, and
		# /tmp is world-writable: any local user could have planted a command
		# in it and had rpcd execute it on the next fan poll.
		while IFS='=' read -r key value; do
			case "$key" in
				HWMON) HWMON="$value" ;;
				PHY1_HWMON) PHY1_HWMON="$value" ;;
				PHY2_HWMON) PHY2_HWMON="$value" ;;
				WIFI_24G_HWMON) WIFI_24G_HWMON="$value" ;;
				WIFI_5G_HWMON) WIFI_5G_HWMON="$value" ;;
				WIFI_6G_HWMON) WIFI_6G_HWMON="$value" ;;
			esac
		done < "$cache"
	fi

	[ -f "$HWMON/name" ] && cached_name=$(cat "$HWMON/name" 2>/dev/null)

	# Re-scan when the cache holds nothing usable, and also when the path it
	# names is no longer the NCT7802. The indices it was keyed on shift when a
	# sensor appears or disappears between boots, and a stale index would have
	# this page report another chip's registers as the fan's.
	if [ -z "$HWMON" ] || [ ! -d "$HWMON" ] || \
	   { [ -n "$cached_name" ] && [ "$cached_name" != "nct7802" ]; }; then
		HWMON=$(_fan_find_nct7802)
		PHY1_HWMON=$(_fan_find_phy_hwmon ":05")
		PHY2_HWMON=$(_fan_find_phy_hwmon ":08")
		WIFI_24G_HWMON=$(_fan_find_mt7996_hwmon 0)
		WIFI_5G_HWMON=$(_fan_find_mt7996_hwmon 1)
		WIFI_6G_HWMON=$(_fan_find_mt7996_hwmon 2)

		{
			printf 'HWMON=%s\n' "$HWMON"
			printf 'PHY1_HWMON=%s\n' "$PHY1_HWMON"
			printf 'PHY2_HWMON=%s\n' "$PHY2_HWMON"
			printf 'WIFI_24G_HWMON=%s\n' "$WIFI_24G_HWMON"
			printf 'WIFI_5G_HWMON=%s\n' "$WIFI_5G_HWMON"
			printf 'WIFI_6G_HWMON=%s\n' "$WIFI_6G_HWMON"
		} > "$cache" 2>/dev/null
	fi
}

# hwmon temperature files are millidegrees.
_fan_read_temp() {
	local file="$1"
	local temp=0
	if [ -f "$file" ]; then
		temp=$(cat "$file" 2>/dev/null || echo 0)
		temp=$((temp / 1000))
	fi
	echo "$temp"
}

_fan_read_value() {
	local file="$1"
	if [ -f "$file" ]; then
		cat "$file" 2>/dev/null || echo 0
	else
		echo 0
	fi
}

get_fan_status() {
	_fan_hwmon_init

	local temp_cpu temp_board temp_phy1 temp_phy2
	local fan_rpm fan_pwm fan_mode fan_percentage

	temp_cpu=$(_fan_read_temp "/sys/class/thermal/thermal_zone0/temp")
	temp_board=$(_fan_read_temp "${HWMON}/temp1_input")

	temp_phy1=$([ -n "$PHY1_HWMON" ] && _fan_read_temp "$PHY1_HWMON/temp1_input" || echo 0)
	temp_phy2=$([ -n "$PHY2_HWMON" ] && _fan_read_temp "$PHY2_HWMON/temp1_input" || echo 0)

	fan_rpm=$(_fan_read_value "${HWMON}/fan1_input")
	fan_pwm=$(_fan_read_value "${HWMON}/pwm1")
	fan_mode=$(_fan_read_value "${HWMON}/pwm1_enable")
	fan_percentage=$((fan_pwm * 100 / 255))

	local wifi_24g=0 wifi_5g=0 wifi_6g=0
	[ -n "$WIFI_24G_HWMON" ] && wifi_24g=$(_fan_read_temp "$WIFI_24G_HWMON/temp1_input")
	[ -n "$WIFI_5G_HWMON" ] && wifi_5g=$(_fan_read_temp "$WIFI_5G_HWMON/temp1_input")
	[ -n "$WIFI_6G_HWMON" ] && wifi_6g=$(_fan_read_temp "$WIFI_6G_HWMON/temp1_input")

	local uci_mode=$(uci -q get fan.settings.mode || echo "auto")
	local uci_preset=$(uci -q get fan.settings.curve_preset || echo "balanced")
	local uci_manual_pwm=$(uci -q get fan.settings.manual_pwm || echo "127")

	local mode_desc="Unknown"
	case "$fan_mode" in
		0) mode_desc="Full Speed" ;;
		1) mode_desc="Manual" ;;
		2) mode_desc="Automatic" ;;
		3) mode_desc="Auto (Closed Loop)" ;;
	esac

	printf '{"temp_cpu":%d,"temp_board":%d,"temp_phy1":%d,"temp_phy2":%d,"wifi_24g":%d,"wifi_5g":%d,"wifi_6g":%d,"fan_rpm":%d,"fan_pwm":%d,"fan_percentage":%d,"fan_mode":%d,"fan_mode_desc":"%s","uci_mode":"%s","uci_preset":"%s","uci_manual_pwm":%d}' \
		"$temp_cpu" "$temp_board" "$temp_phy1" "$temp_phy2" \
		"$wifi_24g" "$wifi_5g" "$wifi_6g" \
		"$fan_rpm" "$fan_pwm" "$fan_percentage" \
		"$fan_mode" "$mode_desc" \
		"$uci_mode" "$uci_preset" "$uci_manual_pwm"
}

get_fan_curve() {
	local preset="$1"
	[ -z "$preset" ] && preset="balanced"
	local points="["
	local first=1
	local i temp pwm
	for i in 1 2 3 4 5; do
		temp=$(uci -q get fan.${preset}.point${i}_temp || echo 0)
		pwm=$(uci -q get fan.${preset}.point${i}_pwm || echo 0)
		[ $first -eq 0 ] && points="${points},"
		first=0
		points="${points}{\"temp\":${temp},\"pwm\":${pwm}}"
	done
	points="${points}]"
	printf '{"preset":"%s","points":%s}' "$preset" "$points"
}

get_all_curves() {
	local curves="{"
	local first=1
	local preset i temp pwm points pfirst
	for preset in quiet balanced performance custom; do
		[ $first -eq 0 ] && curves="${curves},"
		first=0
		points="["
		pfirst=1
		for i in 1 2 3 4 5; do
			temp=$(uci -q get fan.${preset}.point${i}_temp || echo 0)
			pwm=$(uci -q get fan.${preset}.point${i}_pwm || echo 0)
			[ $pfirst -eq 0 ] && points="${points},"
			pfirst=0
			points="${points}{\"temp\":${temp},\"pwm\":${pwm}}"
		done
		points="${points}]"
		curves="${curves}\"${preset}\":${points}"
	done
	curves="${curves}}"
	echo "$curves"
}

set_fan_mode() {
	local mode="$1"
	case "$mode" in
		manual|auto)
			uci set fan.settings.mode="$mode"
			uci commit fan
			/etc/init.d/fan reload
			echo '{"success":true}'
			;;
		*)
			echo '{"success":false,"error":"Invalid mode"}'
			;;
	esac
}

set_manual_pwm() {
	local pwm="$1"
	if [ "$pwm" -ge 0 ] && [ "$pwm" -le 255 ] 2>/dev/null; then
		uci set fan.settings.manual_pwm="$pwm"
		uci commit fan
		/etc/init.d/fan reload
		echo '{"success":true}'
	else
		echo '{"success":false,"error":"Invalid PWM value (0-255)"}'
	fi
}

set_fan_preset() {
	local preset="$1"
	case "$preset" in
		quiet|balanced|performance|custom)
			uci set fan.settings.curve_preset="$preset"
			uci commit fan
			/etc/init.d/fan reload
			echo '{"success":true}'
			;;
		*)
			echo '{"success":false,"error":"Invalid preset"}'
			;;
	esac
}

set_custom_curve() {
	local json i idx temp pwm
	read json
	if command -v jsonfilter >/dev/null 2>&1; then
		for i in 1 2 3 4 5; do
			idx=$((i - 1))
			temp=$(printf '%s' "$json" | jsonfilter -e "@.points[${idx}].temp" 2>/dev/null)
			pwm=$(printf '%s' "$json" | jsonfilter -e "@.points[${idx}].pwm" 2>/dev/null)
			if [ -n "$temp" ] && [ -n "$pwm" ]; then
				uci set fan.custom.point${i}_temp="$temp"
				uci set fan.custom.point${i}_pwm="$pwm"
			fi
		done
		uci set fan.settings.curve_preset="custom"
		uci commit fan
		/etc/init.d/fan reload
		echo '{"success":true}'
	else
		echo '{"success":false,"error":"jsonfilter not available"}'
	fi
}

# --- rpcd entry points ------------------------------------------------------

case "$1" in
	list)
		echo '{"getOverview":{},"getStatus":{},"getPpeEntries":{},"getPpeSummary":{},"getTokenInfo":{},"getFrameEngine":{},"getTxStats":{},"getVlanOffload":{},"getFlowOffload":{},"getPppoeOffload":{},"getApModeOffload":{},"getDeviceMode":{},"getWanHealth":{},"getJitterResult":{},"getWifiStats":{},"getBridgeStats":{},"getNpuBypass":{},"getConflictAlerts":{},"getEthStats":{},"getPingTarget":{},"setPingTarget":{"target":"str"},"getFanStatus":{},"getFanCurve":{"preset":"str"},"getAllCurves":{},"setGovernor":{"governor":"str"},"setMaxFreq":{"freq":"int"},"setVlanOffload":{"enabled":"int"},"setPppoeOffload":{"enabled":"int"},"setFlowOffload":{"enabled":"int"},"setApModeOffload":{"enabled":"int"},"setFanMode":{"mode":"str"},"setManualPwm":{"pwm":"int"},"setFanPreset":{"preset":"str"},"setCustomCurve":{"points":"array"}}'
		;;
	call)
		# Nothing here declares these with "local": this case runs at the top
		# level of the script, not inside a function, and "local" outside a
		# function is an error in busybox ash. _arg is reused per invocation and
		# only ever holds one method's argument, so there is nothing to collide
		# with.
		case "$2" in
			getOverview)
				get_overview
				;;
			getStatus)
				get_status
				;;
			getPpeEntries)
				get_ppe_entries
				;;
			getPpeSummary)
				get_ppe_summary
				;;
			getTokenInfo)
				get_token_info
				;;
			getFrameEngine)
				get_frame_engine
				;;
			getTxStats)
				get_tx_stats
				;;
			getVlanOffload)
				get_vlan_offload
				;;
			getFlowOffload)
				get_flow_offload
				;;
			getPppoeOffload)
				get_pppoe_offload
				;;
			getApModeOffload)
				get_apmode_offload
				;;
			getDeviceMode)
				get_device_mode
				;;
			getWanHealth)
				get_wan_health
				;;
			getJitterResult)
				get_jitter_result
				;;
			getWifiStats)
				get_wifi_stats
				;;
			getBridgeStats)
				get_bridge_stats
				;;
			getNpuBypass)
				get_npu_bypass
				;;
			getConflictAlerts)
				get_conflict_alerts
				;;
			getEthStats)
				get_eth_stats
				;;
			getPingTarget)
				get_ping_target
				;;
			setPingTarget)
				set_ping_target
				;;
			getFanStatus)
				get_fan_status
				;;
			getFanCurve)
				read -r _arg
				get_fan_curve "$(printf '%s' "$_arg" | jsonfilter -e '@.preset' 2>/dev/null)"
				;;
			getAllCurves)
				get_all_curves
				;;
			setGovernor)
				read -r _arg
				set_governor "$_arg"
				;;
			setMaxFreq)
				read -r _arg
				set_max_freq "$_arg"
				;;
			setVlanOffload)
				read -r _arg
				set_vlan_offload "$_arg"
				;;
			setPppoeOffload)
				read -r _arg
				set_pppoe_offload "$_arg"
				;;
			setFlowOffload)
				read -r _arg
				set_flow_offload "$_arg"
				;;
			setApModeOffload)
				read -r _arg
				set_apmode_offload "$_arg"
				;;
			setFanMode)
				read -r _arg
				set_fan_mode "$(printf '%s' "$_arg" | jsonfilter -e '@.mode' 2>/dev/null)"
				;;
			setManualPwm)
				read -r _arg
				set_manual_pwm "$(printf '%s' "$_arg" | jsonfilter -e '@.pwm' 2>/dev/null)"
				;;
			setFanPreset)
				read -r _arg
				set_fan_preset "$(printf '%s' "$_arg" | jsonfilter -e '@.preset' 2>/dev/null)"
				;;
			setCustomCurve)
				set_custom_curve
				;;
			*)
				echo '{"error":"Invalid method"}'
				;;
		esac
		;;
esac
