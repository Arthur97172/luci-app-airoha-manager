_apmode_has_vlan_filtering() {
	local path value

	for path in /sys/class/net/*/bridge/vlan_filtering; do
		[ -r "$path" ] || continue
		value=$(cat "$path" 2>/dev/null)
		[ "$value" = "1" ] && { echo 1; return; }
	done

	echo 0
}

get_apmode_offload() {
	local ipt ip6t arp vlan_filtering filter_vlan_tagged pass_vlan_indev

	# This is the only definition of the AP-mode state now that the three
	# backends are one: luci.airoha_npu and luci.airoha_flowsense each carried a
	# copy of this function and a comment asking that the two be kept aligned.
	ipt=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null)
	ip6t=$(cat /proc/sys/net/bridge/bridge-nf-call-ip6tables 2>/dev/null)
	arp=$(cat /proc/sys/net/bridge/bridge-nf-call-arptables 2>/dev/null)
	vlan_filtering=$(_apmode_has_vlan_filtering)
	filter_vlan_tagged=$(cat /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null)
	pass_vlan_indev=$(cat /proc/sys/net/bridge/bridge-nf-pass-vlan-input-dev 2>/dev/null)

	if [ "$ipt" = "1" ] && [ "$ip6t" = "1" ] && [ "$arp" = "1" ] && \
	   { [ "$vlan_filtering" = "0" ] || { [ "$filter_vlan_tagged" = "1" ] && [ "$pass_vlan_indev" = "1" ]; }; }; then
		printf '{"enabled":1}'
	else
		printf '{"enabled":0}'
	fi
}

get_device_mode() {
	local mode="router"
	local reason=""

	# Primary check: has the user explicitly configured this as a dumb AP?
	local dhcp_ignore
	dhcp_ignore=$(uci get dhcp.lan.ignore 2>/dev/null)
	if [ "$dhcp_ignore" = "1" ]; then
		mode="ap"
		reason="dhcp_disabled"
	fi

	# Secondary check: is the WAN interface up with a real IP?
	if [ "$mode" = "router" ]; then
		local wan_up wan_ip
		wan_up=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@.up" 2>/dev/null)
		wan_ip=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)
		if [ "$wan_up" != "true" ] || [ -z "$wan_ip" ]; then
			mode="ap"
			reason="no_wan"
		fi
	fi

	# Fallback: check if default route points to a local gateway (upstream router)
	if [ "$mode" = "router" ]; then
		local gw
		gw=$(ip route show default 2>/dev/null | awk '/default via/{print $3; exit}')
		if [ -n "$gw" ]; then
			# If gateway is in 192.168.x.x or 10.x.x.x range, we're behind another router
			case "$gw" in
				192.168.*.*|10.*.*.*)
					# Only treat as AP if we have no public WAN IP
					local wan_ip2
					wan_ip2=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)
					if [ -z "$wan_ip2" ]; then
						mode="ap"
						reason="local_gateway"
					fi
					;;
			esac
		fi
	fi

	# bridge_offload_blocked comes from luci.airoha_npu, and is deliberately
	# taken from _has_active_wan rather than derived from $mode above: the
	# bridge offload setters in this same file gate on _bridge_offload_blocked,
	# so a page that greyed its toggles out on any other condition would offer
	# switches the backend then refuses. The two backends disagreed about $mode
	# itself in one corner -- dhcp.lan.ignore=1 together with a live WAN, which
	# luci.airoha_flowsense called "ap" and luci.airoha_npu called "router" --
	# so each keeps its own answer: $mode and $reason are the FlowSense
	# vocabulary its page translates, and this flag is the NPU one its page
	# gates on.
	local blocked="false"
	_has_active_wan && blocked="true"

	printf '{"mode":"%s","reason":"%s","bridge_offload_blocked":%s}' "$mode" "$reason" "$blocked"
}

get_wan_health() {
	# Get WAN interface logical status
	local wan_status
	wan_status=$(ubus call network.interface.wan status 2>/dev/null)

	if [ -z "$wan_status" ]; then
		echo '{"available":false}'
		return
	fi

	local up l3_device uptime
	up=$(echo "$wan_status" | jsonfilter -e "@.up" 2>/dev/null)
	l3_device=$(echo "$wan_status" | jsonfilter -e "@.l3_device" 2>/dev/null)
	uptime=$(echo "$wan_status" | jsonfilter -e "@.uptime" 2>/dev/null)

	# Get device-level statistics via ip -s link
	local rx_bytes=0 tx_bytes=0 rx_errors=0 tx_errors=0 rx_dropped=0 tx_dropped=0 collisions=0
	if [ -n "$l3_device" ]; then
		local stats
		stats=$(ip -s link show "$l3_device" 2>/dev/null)
		if [ -n "$stats" ]; then
			# ip -s link output: RX line followed by bytes/packets/errors/dropped/...
			# TX line followed by same
			rx_bytes=$(echo "$stats" | awk '/^    [0-9]/{if(rx==1){print $1+0; rx=0}} /RX:/{rx=1}')
			tx_bytes=$(echo "$stats" | awk '/^    [0-9]/{if(tx==1){print $1+0; tx=0}} /TX:/{tx=1}')
			rx_errors=$(echo "$stats" | awk '/RX:/{getline; print $3+0}')
			tx_errors=$(echo "$stats" | awk '/TX:/{getline; print $3+0}')
			rx_dropped=$(echo "$stats" | awk '/RX:/{getline; print $4+0}')
			tx_dropped=$(echo "$stats" | awk '/TX:/{getline; print $4+0}')
		fi
	fi

	printf '{"available":true,"up":%s,"device":"%s","uptime":%d,"rx_bytes":%d,"tx_bytes":%d,"rx_errors":%d,"tx_errors":%d,"rx_dropped":%d,"tx_dropped":%d}' \
		"${up:-false}" "${l3_device:-}" "${uptime:-0}" \
		"${rx_bytes:-0}" "${tx_bytes:-0}" \
		"${rx_errors:-0}" "${tx_errors:-0}" \
		"${rx_dropped:-0}" "${tx_dropped:-0}"
}

